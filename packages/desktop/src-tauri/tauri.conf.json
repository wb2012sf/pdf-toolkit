{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PDF_Toolkit",
  "version": "0.1.0",
  "identifier": "com.wb2012sf.pdf-toolkit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "PDF Toolkit",
        "width": 900,
        "height": 800,
        "minWidth": 520,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Merge, split and reorder PDF pages",
    "longDescription": "Page level PDF manipulation. Files are processed on this machine and never uploaded."
  }
}
