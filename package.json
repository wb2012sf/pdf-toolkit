{
  "name": "pdf-toolkit",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24 <25"
  },
  "workspaces": ["packages/*"],
  "scripts": {
    "build": "npm run build -w @pdf-toolkit/core && npm run build -w @pdf-toolkit/cli",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write .",
    "audit": "npm audit --audit-level=moderate"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
